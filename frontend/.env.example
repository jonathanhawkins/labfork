# Backend URL
NEXT_PUBLIC_API_URL=

# Cloudflare Workers Agents API URL
# Used for the autonomous agent system
NEXT_PUBLIC_AGENTS_API_URL=http://localhost:8787

# Hugging Face Token
HF_TOKEN=

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# xAI (Grok) API Key
# Get your key at: https://console.x.ai/team/default/api-keys
# Used for Live Search (X/Twitter and web search)
XAI_API_KEY=xai-your_api_key_here
