# AI Research Lab - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Ports
# =============================================================================
FRONTEND_PORT=3003
BACKEND_PORT=8003
OLLAMA_PORT=11434
DB_PORT=5432

# =============================================================================
# Database
# =============================================================================
DB_PASSWORD=your-secure-password-here

# =============================================================================
# API Keys (Optional - enhance functionality)
# =============================================================================

# Anthropic API Key - Required for Claude-powered features
ANTHROPIC_API_KEY=

# OpenAI API Key - Optional, for alternative LLM provider
OPENAI_API_KEY=

# Semantic Scholar API Key - Increases rate limits for paper fetching
SEMANTIC_SCHOLAR_API_KEY=

# =============================================================================
# Feature Flags
# =============================================================================

# Enable GPU acceleration (requires nvidia-docker)
USE_GPU=false

# Enable debug logging
DEBUG=false

# =============================================================================
# Ollama Configuration
# =============================================================================

# Default model to use (will be pulled on startup)
OLLAMA_MODEL=qwen3-coder:30b

# Context window size
OLLAMA_CTX_SIZE=32768

# =============================================================================
# Remote GPU Training (Optional)
# =============================================================================

# Remote GPU host for training (e.g., RTX 4090 machine via Tailscale)
REMOTE_GPU_HOST=
REMOTE_GPU_USER=doc

# Frontend-accessible versions (for UI display)
NEXT_PUBLIC_REMOTE_GPU_HOST=
NEXT_PUBLIC_REMOTE_GPU_USER=doc

# =============================================================================
# Cloud Provider (for remote deployments)
# =============================================================================

# RunPod API Key
RUNPOD_API_KEY=

# AWS Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# GCP Credentials
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=
