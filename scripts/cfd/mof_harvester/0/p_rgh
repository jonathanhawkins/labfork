FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Pressure minus hydrostatic component
// For compressible flow: absolute pressure units [Pa]

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    sorbent
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    dome
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    sides
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
}

