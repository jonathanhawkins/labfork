FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Turbulent thermal diffusivity (zero for laminar)

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    sorbent
    {
        type            calculated;
        value           uniform 0;
    }

    dome
    {
        type            calculated;
        value           uniform 0;
    }

    sides
    {
        type            calculated;
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
}

