#!/bin/bash
# Start Haiku-supervised lab manager (disabled by default)
# This lab does not use Anthropic by default. Use research-manager + Codex instead.

cd "$(dirname "$0")/.."

if [ "${ALLOW_ANTHROPIC:-}" != "true" ]; then
    echo "❌ Anthropic supervisor disabled (ALLOW_ANTHROPIC=true to override)."
    echo "   Use: ./.skills/research-manager/rm orchestrator start"
    exit 1
fi

# Check if Ollama is running
if ! curl -s http://localhost:11434/api/tags > /dev/null 2>&1; then
    echo "❌ Ollama not running. Start Ollama app first!"
    exit 1
fi

echo "🧠 Haiku-Supervised Lab Manager"
echo "================================"
echo "Supervisor: Claude Haiku (~\$0.25/1M tokens)"
echo "Worker:     Ollama qwen3-coder-32k (FREE)"
echo ""
echo "Usage:"
echo "  $0              # Run 50 iterations"
echo "  $0 --continuous # Run until Ctrl+C"
echo "  $0 --check      # Check if lab manager running"
echo ""

python3 scripts/haiku_lab_supervisor.py "$@"
