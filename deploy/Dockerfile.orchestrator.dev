# AI Research Lab - Orchestrator Development Dockerfile

FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    httpx>=0.26.0 \
    aiohttp>=3.9.0 \
    asyncpg>=0.29.0 \
    pydantic>=2.5.0 \
    python-dotenv>=1.0.0 \
    tenacity>=8.2.0 \
    rich>=13.7.0 \
    watchdog>=4.0.0

# Set development environment
ENV PYTHONUNBUFFERED=1
ENV DEBUG=true
ENV LOG_LEVEL=debug

CMD ["python", "-m", "skills.orchestrator", "--reload"]
